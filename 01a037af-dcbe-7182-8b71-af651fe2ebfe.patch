-      const pdfBlob = await html2pdfLib()
-        .set(options)
-        .from(container)
-        .output('blob');
-
-      // 7. Clean up
-      if (container && container.parentNode) {
-        document.body.removeChild(container);
-      }
-
-      hideLoading();
-
-      // 8. Return Blob
-      return pdfBlob;
-
-    } catch (error) {
-      if (container && container.parentNode) {
-        document.body.removeChild(container);
-      }
-      hideLoading();
-      throw new Error(`Word to PDF conversion failed: ${error.message}`);
-    }
-  }
