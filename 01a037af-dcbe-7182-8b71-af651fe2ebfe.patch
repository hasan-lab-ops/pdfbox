+++ b/deploy/nginx-site-convert-snippet.conf
@@ -0,0 +1,40 @@
+# Snippet for the MAIN site's existing nginx server block (pdfbox.online)
+# -----------------------------------------------------------------------
+# The frontend on https://www.pdfbox.online calls the SAME-ORIGIN /convert
+# endpoint (fetch("/convert")), so the main vhost must forward /convert and
+# /health to the local API. Add these two locations INSIDE the existing
+# `server { ... }` block of pdfbox.online, then:
+#
+#   sudo nginx -t && sudo systemctl reload nginx
+
+# Uptime probe used by the frontend health check
+location = /health {
+    proxy_pass http://127.0.0.1:8000;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    access_log off;
+    add_header Cache-Control "no-store" always;
+}
+
+# PDF -> Word conversion (same origin for the frontend)
+location = /convert {
+    proxy_pass http://127.0.0.1:8000;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+
+    # 20 MB API limit + multipart overhead
+    client_max_body_size 25m;
+    proxy_request_buffering off;
+
+    proxy_connect_timeout 10s;
+    proxy_send_timeout 300s;
+    proxy_read_timeout 300s;
+
+    add_header Cache-Control "no-store" always;
+}
diff --git a/deploy/pdfbox.service b/deploy/pdfbox.service
new file mode 100644
index 0000000..d50ebf3
--- /dev/null
+++ b/deploy/pdfbox.service
@@ -0,0 +1,50 @@
+# /etc/systemd/system/pdfbox.service
+# PDFBox.online — PDF to Word conversion API
+#
+# Install:
+#   sudo useradd -r -s /usr/sbin/nologin pdfbox
+#   sudo mkdir -p /opt/pdfbox && sudo cp -r <repo files: main.py, requirements.txt> /opt/pdfbox/
+#   sudo -u pdfbox python3 -m venv /opt/pdfbox/venv
+#   sudo -u pdfbox /opt/pdfbox/venv/bin/pip install -r /opt/pdfbox/requirements.txt
+#   sudo chown -R pdfbox:pdfbox /opt/pdfbox
+#   sudo cp deploy/pdfbox.service /etc/systemd/system/pdfbox.service
+#   sudo systemctl daemon-reload
+#   sudo systemctl enable --now pdfbox
+#
+# Verify:  systemctl status pdfbox && curl -s http://127.0.0.1:8000/health
+
+[Unit]
+Description=PDFBox.online PDF-to-Word conversion API (pdfbox.online)
+After=network.target
+
+[Service]
+Type=simple
+User=pdfbox
+Group=pdfbox
+WorkingDirectory=/opt/pdfbox
+
+# Runtime tuning (match the values the frontend/nginx expect)
+Environment=PYTHONUNBUFFERED=1
+Environment=MAX_UPLOAD_MB=20
+Environment=CONVERSION_TIMEOUT_SECONDS=180
+Environment=MAX_CONCURRENT_CONVERSIONS=2
+# Leave unset in production: the service then uses the strict production
+# CORS origins (https://pdfbox.online, https://www.pdfbox.online).
+
+ExecStart=/opt/pdfbox/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
+
+# Keep it alive
+Restart=always
+RestartSec=3
+TimeoutStopSec=30
+
+# Hardening
+NoNewPrivileges=true
+PrivateTmp=true
+ProtectSystem=full
+ProtectHome=true
+RestrictSUIDSGID=true
+LimitNOFILE=65536
+
+[Install]
+WantedBy=multi-user.target
