-                    if not p.text:
-                        continue
-                    if is_arabic(p.text):
-                        reshaped = arabic_reshaper.reshape(p.text)
-                        bidi_text = get_display(reshaped)
-                        p.clear()
-                        run = p.add_run(bidi_text)
-                        run.font.name = 'Arial'
-                        p.alignment = WD_ALIGN_PARAGRAPH.RIGHT
-
-    doc.save(out_path)
